# ---------------------------------------------------------------------------
# Harness comparison orchestrator
# Copy to .env and edit. Never commit real credentials.
# ---------------------------------------------------------------------------

# Postgres durable records and Redis Streams transport. When the orchestrator
# runs on the host, use the published localhost ports created by `infra up`.
DATABASE_URL=postgresql://cc:cc@127.0.0.1:55432/harness_compare
REDIS_URL=redis://127.0.0.1:56379/0

# When the orchestrator runs in a container on the cc-infra network, use:
# DATABASE_URL=postgresql://cc:cc@cc-postgres:5432/harness_compare
# REDIS_URL=redis://cc-redis:6379/0

DATA_DIR=./data
RUNS_DIR=./data/runs
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO
ORCH_API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Inline comparison consumer. Disable if you run `python -m harness_compare.worker`
# as a separate process.
RUN_ORCHESTRATOR_WORKER=true
MAX_ACTIVE_COMPARISONS=2

# Docker CLI. The local Docker endpoint may be a Podman shim; Compose is not used.
DOCKER_BIN=docker
INFRA_NETWORK=cc-infra
NETWORK_PREFIX=cc-cmp
POSTGRES_CONTAINER=cc-postgres
REDIS_CONTAINER=cc-redis

# Optional container on the comparison network. Use this for a local
# OpenAI-compatible router. It is attached best-effort.
ROUTER_CONTAINER=

# Redis URL as seen by harness workers. Defaults to redis://<REDIS_CONTAINER>:6379/0.
# Set this explicitly for an external Redis.
WORKER_REDIS_URL=

# OpenAI-compatible router used by model calls. LLM_BASE_URL is used by the
# orchestrator host and by workers unless WORKER_LLM_BASE_URL is set. For a
# router container, set WORKER_LLM_BASE_URL to its in-network URL.
LLM_BASE_URL=https://router.example.com/v1
LLM_API_KEY=
WORKER_LLM_BASE_URL=
# Offline deterministic test double: see dev/mock_llm.py and README.
# LLM_BASE_URL=http://mock-llm:4010/v1
# WORKER_LLM_BASE_URL=http://mock-llm:4010/v1
# ROUTER_CONTAINER=mock-llm
DEFAULT_MODELS=
LLM_JSON_MODE=false
LLM_MAX_RETRIES=3
LLM_TIMEOUT_S=90
LLM_RPM=60
LLM_MAX_CONCURRENCY=4

# Per-request ceilings sent to harnesses and clamped again inside each harness.
SERVER_MAX_LLM_CALLS=8
SERVER_MAX_INPUT_TOKENS=60000
SERVER_MAX_OUTPUT_TOKENS=8000
SERVER_MAX_TOTAL_TOKENS=80000
SERVER_MAX_WALL_SECONDS=180
SERVER_MAX_COST_USD=1.00
JOB_BUDGET_WALL_SECONDS=180

# Repositories and datasets. Production default allows only github.com.
REPO_ALLOWED_HOSTS=github.com,www.github.com
ALLOW_LOCAL_REPO=false
GIT_TOKEN=
GIT_TIMEOUT_S=300
ALLOW_LOCAL_DATASET=false
MAX_UPLOAD_MB=50
MAX_CASES=100
MAX_MODELS=6
MAX_TRIALS=5
MAX_JOBS=2000
HARNESS_SUBDIR=

# Orchestrator and job limits.
BUILD_TIMEOUT_S=1800
WORKER_READY_TIMEOUT_S=120
JOB_TIMEOUT_S=600
COMPARISON_TIMEOUT_S=7200
POLL_INTERVAL_S=1.0
PROGRESS_INTERVAL_S=3.0
MAX_INFLIGHT_PER_HARNESS=1
WORKER_RESTARTS=0
# Resource ceilings. Leave these at the hardened defaults on production hosts.
# Rootless Podman without the memory/cpu/pids cgroup controllers cannot create
# limited containers; on such a host set WORKER_MEMORY=, WORKER_CPUS=, and
# WORKER_PIDS=0. Read-only, dropped capabilities, and no-new-privileges remain.
WORKER_MEMORY=2g
WORKER_CPUS=2
WORKER_PIDS=256
WORKER_TMPFS_MB=512
WORKER_READ_ONLY=true

# Debugging retention. Keep these false in normal runs.
KEEP_WORKERS=false
KEEP_NETWORK=false
KEEP_WORKTREES=false
KEEP_IMAGES=false
